{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/uno", "destination": "/uno.html" },
    { "source": "/callbreak", "destination": "/callbreak.html" },
    { "source": "/poker", "destination": "/poker.html" },
    { "source": "/blackjack", "destination": "/blackjack.html" },
    { "source": "/connect4", "destination": "/connect4.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
